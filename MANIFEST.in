include README.md SECURITY.md THIRD_PARTY_NOTICES.md SKILL.md
include requirements-console.txt package.json package-lock.json playwright.config.js
recursive-include config *.json *.md
recursive-include docs *.md
recursive-include tests *.py *.ps1 *.js *.json
recursive-include scripts *.ps1
recursive-include scripts/wechat_ai_control/web *.html *.css *.js LICENSE.*
global-exclude *.pyc *.log *.db *.sqlite *.png
prune .planning
prune .local
prune .venv
prune node_modules
